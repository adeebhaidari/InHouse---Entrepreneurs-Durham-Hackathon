            if (currentUser.bio) score += 10;
            if (currentUser.mbti) score += 15;
            if (currentUser.hobbies.length > 0) score += 15;
            if (score > 100) score = 100;

            document.getElementById('match-completeness-pct').textContent = score + '%';
            document.getElementById('hero-progress-bar').style.width = score + '%';
        }

