        // --- TOAST NOTIFICATIONS ---
        function showToast(message) {
            const container = document.getElementById('toast-container');
            const toast = document.createElement('div');
            toast.className = 'bg-[#112519] text-[#e3f1e5] px-5 py-3 rounded-2xl shadow-xl text-xs font-semibold flex items-center gap-3 animate-fade-in pointer-events-auto border border-[#1f422c]';
            toast.innerHTML = `<i class="fa-solid fa-circle-check text-[#e3f1e5] text-sm"></i><span>${message}</span>`;
            container.appendChild(toast);
            setTimeout(() => {
                toast.style.opacity = '0';
                toast.style.transition = 'opacity 0.3s ease';
                setTimeout(() => toast.remove(), 300);
            }, 3500);
