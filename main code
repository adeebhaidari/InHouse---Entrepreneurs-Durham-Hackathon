<!DOCTYPE html>
<html lang="en" class="h-full">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>inhouse - Durham University Student Accommodation & Roommate Network</title>
    <!-- Tailwind CSS CDN -->
    <script src="https://cdn.tailwindcss.com"></script>
    <!-- FontAwesome for Icons -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <!-- Google Fonts: Inter -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <script>
        tailwind.config = {
            theme: {
                extend: {
                    fontFamily: {
                        sans: ['Inter', sans-serif],
                    },
                    colors: {
                        inhouse: {
                            bg: '#f9f8f4',
                            card: '#ffffff',
                            dark: '#112519',
                            sage: '#e3f1e5',
                            sageHover: '#d0e6d3',
                            peach: '#faeedc',
                            accent: '#1f422c',
                            muted: '#657166'
                        }
                    }
                }
            }
        }
    </script>
    <style>
        body { background-color: #f9f8f4; font-family: 'Inter', sans-serif; color: #112519; }
        .custom-scrollbar::-webkit-scrollbar { width: 6px; height: 6px; }
        .custom-scrollbar::-webkit-scrollbar-track { background: #f4f2ed; }
        .custom-scrollbar::-webkit-scrollbar-thumb { background: #cbd5cb; border-radius: 9999px; }
        .custom-scrollbar::-webkit-scrollbar-thumb:hover { background: #abc0ab; }
        @keyframes fadeIn {
            from { opacity: 0; transform: translateY(6px); }
            to { opacity: 1; transform: translateY(0); }
        }
        .animate-fade-in { animation: fadeIn 0.3s ease-out forwards; }
    </style>
</head>
<body class="h-full flex flex-col selection:bg-[#112519] selection:text-[#e3f1e5]">

    <!-- Notification Toast Container -->
    <div id="toast-container" class="fixed top-5 right-5 z-50 flex flex-col gap-3 pointer-events-none"></div>

    <!-- Auth / Profile Setup Modal -->
    <div id="auth-modal" class="fixed inset-0 bg-[#112519]/50 backdrop-blur-xs z-50 flex items-center justify-center p-4 hidden">
        <div class="bg-white rounded-3xl shadow-2xl max-w-md w-full p-8 relative animate-fade-in border border-[#e3f1e5]">
            <button onclick="closeAuthModal()" class="absolute top-4 right-4 text-slate-400 hover:text-[#112519] transition">
                <i class="fa-solid fa-xmark text-xl"></i>
            </button>
            <div class="text-center mb-6">
                <div class="inline-flex items-center justify-center w-12 h-12 bg-[#112519] text-[#e3f1e5] rounded-2xl mb-3 shadow-sm font-bold text-lg">
                    in
                </div>
                <h3 class="text-2xl font-bold text-[#112519]">Welcome to inhouse</h3>
                <p class="text-xs text-[#657166] mt-1">Durham University's private student housing & roommate network</p>
            </div>
            
            <div class="space-y-3 mb-6">
                <button onclick="loginWithProvider('Google')" class="w-full flex items-center justify-center gap-3 py-3 px-4 border border-slate-200 rounded-2xl font-medium text-slate-700 hover:bg-[#f9f8f4] transition shadow-xs text-sm">
                    <i class="fa-brands fa-google text-red-500 text-base"></i> Continue with Google
                </button>
                <button onclick="loginWithProvider('Yahoo')" class="w-full flex items-center justify-center gap-3 py-3 px-4 border border-slate-200 rounded-2xl font-medium text-slate-700 hover:bg-[#f9f8f4] transition shadow-xs text-sm">
                    <i class="fa-brands fa-yahoo text-purple-600 text-base"></i> Continue with Yahoo
                </button>
                <button onclick="loginWithProvider('Durham University Email')" class="w-full flex items-center justify-center gap-3 py-3 px-4 border border-slate-200 rounded-2xl font-medium text-slate-700 hover:bg-[#f9f8f4] transition shadow-xs text-sm">
                    <i class="fa-solid fa-envelope text-[#112519] text-base"></i> Durham Email (@durham.ac.uk)
                </button>
            </div>

            <div class="relative flex py-2 items-center mb-6">
                <div class="flex-grow border-t border-slate-200"></div>
                <span class="flex-shrink mx-4 text-[10px] text-slate-400 uppercase tracking-widest font-semibold">Quick demo sign in</span>
                <div class="flex-grow border-t border-slate-200"></div>
            </div>

            <div class="grid grid-cols-2 gap-3">
                <button onclick="quickDemoLogin('jamie')" class="p-3 border border-[#e3f1e5] bg-[#e3f1e5]/40 hover:bg-[#e3f1e5] rounded-2xl text-left transition">
                    <span class="block font-semibold text-xs text-[#112519]">Jamie Smith</span>
                    <span class="block text-[11px] text-[#657166]">Durham College • 87% Match</span>
                </button>
                <button onclick="quickDemoLogin('sophie')" class="p-3 border border-[#e3f1e5] bg-[#e3f1e5]/40 hover:bg-[#e3f1e5] rounded-2xl text-left transition">
                    <span class="block font-semibold text-xs text-[#112519]">Sophie Williams</span>
                    <span class="block text-[11px] text-[#657166]">Law • 96% Match</span>
                </button>
            </div>
        </div>
    </div>

    <!-- Main Layout Grid -->
    <div class="flex-grow flex flex-col md:flex-row min-h-screen">
        
        <!-- Left Sidebar Navigation -->
        <aside class="w-full md:w-64 bg-white border-r border-[#e3f1e5] flex flex-col justify-between p-6 shrink-0 shadow-xs">
            <div class="space-y-8">
                <!-- Logo -->
                <div class="flex items-center gap-3">
                    <div class="w-9 h-9 bg-[#112519] text-[#e3f1e5] rounded-xl flex items-center justify-center font-bold text-sm shadow-xs">
                        in
                    </div>
                    <div>
                        <span class="text-xl font-bold tracking-tight text-[#112519]">inhouse</span>
                        <span class="block text-[10px] text-[#657166] font-semibold">Durham University</span>
                    </div>
                </div>

                <!-- Nav links -->
                <div>
                    <span class="block text-[10px] font-bold tracking-wider text-[#657166] uppercase mb-3">Workspace</span>
                    <nav class="space-y-1">
                        <button onclick="switchTab('discover')" id="nav-discover" class="w-full flex items-center gap-3 px-3.5 py-2.5 rounded-xl text-sm font-medium transition text-[#112519] bg-[#e3f1e5]">
                            <i class="fa-solid fa-compass text-base w-5 text-center"></i> Discover
                        </button>
                        <button onclick="switchTab('shortlist')" id="nav-shortlist" class="w-full flex items-center gap-3 px-3.5 py-2.5 rounded-xl text-sm font-medium transition text-[#657166] hover:bg-[#e3f1e5]/50 hover:text-[#112519]">
                            <i class="fa-solid fa-bookmark text-base w-5 text-center"></i> My shortlist
                        </button>
                        <button onclick="switchTab('messages')" id="nav-messages" class="w-full flex items-center justify-between px-3.5 py-2.5 rounded-xl text-sm font-medium transition text-[#657166] hover:bg-[#e3f1e5]/50 hover:text-[#112519]">
                            <div class="flex items-center gap-3">
                                <i class="fa-solid fa-comment text-base w-5 text-center"></i> Messages
                            </div>
                            <span id="sidebar-msg-badge" class="bg-[#e3f1e5] text-[#112519] text-xs font-bold px-2 py-0.5 rounded-full">3</span>
                        </button>
                        <button onclick="switchTab('profile')" id="nav-profile" class="w-full flex items-center gap-3 px-3.5 py-2.5 rounded-xl text-sm font-medium transition text-[#657166] hover:bg-[#e3f1e5]/50 hover:text-[#112519]">
                            <i class="fa-solid fa-user text-base w-5 text-center"></i> My Profile & Vibe Check
                        </button>
                    </nav>
                </div>
            </div>

            <!-- Sidebar Promo Box -->
            <div class="space-y-6">
                <div class="bg-[#112519] text-[#e3f1e5] p-5 rounded-3xl relative overflow-hidden shadow-sm">
                    <div class="absolute -right-4 -bottom-4 text-white/10 text-6xl pointer-events-none">
                        <i class="fa-solid fa-sparkles"></i>
                    </div>
                    <h4 class="font-bold text-sm mb-1.5 flex items-center gap-2">
                        <i class="fa-solid fa-sparkles text-[#e3f1e5]"></i> Make your profile shine
                    </h4>
                    <p class="text-[11px] text-[#e3f1e5]/80 leading-relaxed mb-4">
                        Complete your profile & MBTI vibe check for top Durham housemate matches.
                    </p>
                    <button onclick="switchTab('profile')" class="w-full py-2.5 bg-[#e3f1e5] hover:bg-white text-[#112519] font-bold text-xs rounded-xl transition shadow-xs">
                        Complete profile &rarr;
                    </button>
                </div>

                <!-- User profile snippet at bottom of sidebar -->
                <div class="pt-4 border-t border-[#e3f1e5] flex items-center justify-between">
                    <div class="flex items-center gap-3 cursor-pointer" onclick="switchTab('profile')">
                        <img id="sidebar-user-avatar" src="https://images.unsplash.com/photo-1534528741775-53994a69daeb?w=150&auto=format&fit=crop&q=80" class="w-9 h-9 rounded-full object-cover border border-[#e3f1e5]" alt="Avatar">
                        <div>
                            <span id="sidebar-user-name" class="block text-xs font-bold text-[#112519] leading-tight">Jamie Smith</span>
                            <span class="block text-[10px] text-[#657166]">Durham &bull; Student</span>
                        </div>
                    </div>
                    <button onclick="openAuthModal()" title="Switch Account" class="text-xs text-[#657166] hover:text-[#112519] transition">
                        <i class="fa-solid fa-arrow-right-arrow-left"></i>
                    </button>
                </div>
            </div>
        </aside>

        <!-- Main Content View Area -->
        <main class="flex-grow flex flex-col min-w-0 bg-[#f9f8f4] overflow-y-auto">
            
            <!-- Top Nav Bar -->
            <header class="bg-white border-b border-[#e3f1e5] px-6 py-4 sticky top-0 z-30 flex items-center justify-between gap-4">
                <div class="relative flex-grow max-w-xl">
                    <i class="fa-solid fa-magnifying-glass absolute left-3.5 top-3.5 text-slate-400 text-sm"></i>
                    <input type="text" id="top-search-input" oninput="handleGlobalSearch(event)" placeholder="Search Durham areas (Elvet, Viaduct, Claypath)..." class="w-full pl-10 pr-4 py-2 bg-[#f9f8f4] border border-slate-200 rounded-2xl text-sm focus:outline-none focus:border-[#112519] transition">
                </div>
                
                <div class="flex items-center gap-3">
                    <button onclick="showToast('You have 2 new notifications regarding Durham property viewings.')" class="w-10 h-10 bg-[#f9f8f4] hover:bg-[#e3f1e5]/40 border border-slate-200 rounded-2xl flex items-center justify-center text-[#112519] relative transition">
                        <i class="fa-regular fa-bell text-sm"></i>
                        <span class="absolute top-2 right-2 w-2 h-2 bg-emerald-600 rounded-full"></span>
                    </button>
                    <div class="flex items-center gap-2 bg-[#f9f8f4] border border-slate-200 px-3 py-1.5 rounded-2xl cursor-pointer" onclick="switchTab('profile')">
                        <img id="header-mini-avatar" src="https://images.unsplash.com/photo-1534528741775-53994a69daeb?w=150&auto=format&fit=crop&q=80" class="w-7 h-7 rounded-full object-cover">
                        <span id="header-mini-name" class="text-xs font-semibold text-[#112519]">Jamie</span>
                        <i class="fa-solid fa-chevron-down text-[10px] text-slate-400"></i>
                    </div>
                </div>
            </header>

            <!-- TAB 1: DISCOVER / HOME VIEW -->
            <section id="tab-discover" class="p-6 md:p-8 space-y-8 animate-fade-in">
                
                <!-- Sliding Hero Banner with Inclusive Student Imagery & Alternating Every 5 Seconds -->
                <div class="relative rounded-3xl overflow-hidden shadow-md min-h-[260px] flex flex-col justify-end text-white">
                    <!-- Slides Container -->
                    <div id="hero-slider-container" class="absolute inset-0 w-full h-full">
                        <!-- Slide 1 -->
                        <div class="absolute inset-0 bg-cover bg-center transition-opacity duration-1000 hero-slide opacity-100" style="background-image: linear-gradient(rgba(17,37,25,0.75), rgba(31,66,44,0.6)), url('https://images.unsplash.com/photo-1523240795612-9a054b0db644?w=1200&auto=format&fit=crop&q=80');"></div>
                        <!-- Slide 2 -->
                        <div class="absolute inset-0 bg-cover bg-center transition-opacity duration-1000 hero-slide opacity-0" style="background-image: linear-gradient(rgba(17,37,25,0.75), rgba(31,66,44,0.6)), url('https://images.unsplash.com/photo-1529156069898-49953e39b3ac?w=1200&auto=format&fit=crop&q=80');"></div>
                        <!-- Slide 3 -->
                        <div class="absolute inset-0 bg-cover bg-center transition-opacity duration-1000 hero-slide opacity-0" style="background-image: linear-gradient(rgba(17,37,25,0.75), rgba(31,66,44,0.6)), url('https://images.unsplash.com/photo-1517486808906-6ca8b3f04846?w=1200&auto=format&fit=crop&q=80');"></div>
                    </div>

                    <!-- Slide Content Overlay -->
                    <div class="relative z-10 p-8 md:p-10 space-y-2">
                        <span class="inline-block px-3 py-1 bg-[#e3f1e5] text-[#112519] text-xs font-bold rounded-xl uppercase tracking-widest">Durham University</span>
                        <h1 id="hero-title-text" class="text-3xl md:text-5xl font-extrabold tracking-tight">Match your mates & find your dream home</h1>
                        <p id="hero-desc-text" class="text-sm md:text-base text-slate-200 max-w-xl">Connect with verified Durham students and secure private accommodation together.</p>
                    </div>

                    <!-- Slider Nav Dots & Arrows -->
                    <div class="absolute bottom-6 right-6 z-20 flex items-center gap-3">
                        <div class="flex items-center gap-1.5 bg-black/30 backdrop-blur-xs px-3 py-1.5 rounded-full" id="slider-dots">
                            <button onclick="currentSlide(0)" class="w-2.5 h-2.5 rounded-full bg-white transition"></button>
                            <button onclick="currentSlide(1)" class="w-2.5 h-2.5 rounded-full bg-white/50 transition"></button>
                            <button onclick="currentSlide(2)" class="w-2.5 h-2.5 rounded-full bg-white/50 transition"></button>
                        </div>
                        <button onclick="showToast('Interactive map view enabled for Durham')" class="px-4 py-2 bg-white/95 hover:bg-white text-[#112519] rounded-xl text-xs font-bold flex items-center gap-2 transition shadow-md">
                            <i class="fa-solid fa-map-location-dot text-[#1f422c]"></i> Map
                        </button>
                    </div>
                </div>

                <!-- Location & Filter Bar -->
                <div class="bg-white p-3 rounded-3xl border border-[#e3f1e5] shadow-xs flex flex-wrap items-center gap-3">
                    <div class="flex-grow min-w-[240px] flex items-center gap-3 px-4 py-2.5 bg-[#f9f8f4] rounded-2xl border border-slate-200">
                        <i class="fa-solid fa-location-dot text-[#1f422c]"></i>
                        <div class="flex flex-col">
                            <span class="text-[10px] text-[#657166] font-bold uppercase tracking-wider">LOOKING NEAR</span>
                            <span class="text-xs font-semibold text-[#112519]">Durham University Campus & Colleges</span>
                        </div>
                    </div>
                    
                    <div class="flex items-center gap-3 px-4 py-2.5 bg-[#f9f8f4] rounded-2xl border border-slate-200">
                        <i class="fa-regular fa-calendar text-[#1f422c]"></i>
                        <div class="flex flex-col">
                            <span class="text-[10px] text-[#657166] font-bold uppercase tracking-wider">MOVE IN</span>
                            <span class="text-xs font-semibold text-[#112519]">September 2026</span>
                        </div>
                    </div>

                    <button onclick="openFilterModal()" class="px-5 py-3 bg-[#e3f1e5] hover:bg-[#d0e6d3] text-[#112519] rounded-2xl text-xs font-bold flex items-center gap-2 transition">
                        <i class="fa-solid fa-sliders"></i> Filters
                    </button>
                </div>

                <!-- Quick Stats Cards -->
                <div class="grid grid-cols-1 md:grid-cols-3 gap-5">
                    <!-- Card 1: Match Profile -->
                    <div class="bg-[#e3f1e5]/60 hover:bg-[#e3f1e5] border border-[#e3f1e5] p-6 rounded-3xl transition space-y-4 cursor-pointer" onclick="switchTab('profile')">
                        <div class="flex items-center justify-between">
                            <span class="text-[10px] font-bold tracking-widest text-[#657166] uppercase">YOUR MATCH PROFILE</span>
                            <i class="fa-solid fa-wand-magic-sparkles text-[#1f422c]"></i>
                        </div>
                        <div>
                            <div class="text-3xl font-extrabold text-[#112519]" id="match-completeness-pct">87%</div>
                            <span class="text-xs text-[#657166]">profile & MBTI completeness</span>
                        </div>
                        <div class="w-full bg-[#112519]/10 h-2 rounded-full overflow-hidden">
                            <div id="hero-progress-bar" class="bg-[#1f422c] h-full rounded-full transition-all duration-500" style="width: 87%"></div>
                        </div>
                    </div>

                    <!-- Card 2: People Like You -->
                    <div class="bg-white hover:bg-slate-50 border border-[#e3f1e5] p-6 rounded-3xl transition space-y-4 cursor-pointer shadow-xs" onclick="switchTab('profile')">
                        <div class="flex items-center justify-between">
                            <span class="text-[10px] font-bold tracking-widest text-[#657166] uppercase">PEOPLE LIKE YOU</span>
                            <i class="fa-solid fa-users text-[#1f422c]"></i>
                        </div>
                        <div>
                            <div class="text-3xl font-extrabold text-[#112519]">18 <span class="text-sm font-normal text-[#657166]">nearby in Durham</span></div>
                            <span class="text-xs text-[#657166]">looking for private student accommodation</span>
                        </div>
                        <div class="text-xs font-bold text-[#1f422c] flex items-center gap-1">
                            Explore roommate vibe checks &rarr;
                        </div>
                    </div>

                    <!-- Card 3: Saved Homes -->
                    <div class="bg-white hover:bg-slate-50 border border-[#e3f1e5] p-6 rounded-3xl transition space-y-4 cursor-pointer shadow-xs" onclick="switchTab('shortlist')">
                        <div class="flex items-center justify-between">
                            <span class="text-[10px] font-bold tracking-widest text-[#657166] uppercase">SAVED HOMES</span>
                            <i class="fa-regular fa-heart text-rose-500"></i>
                        </div>
                        <div>
                            <div id="saved-homes-count-display" class="text-3xl font-extrabold text-[#112519]">2 <span class="text-sm font-normal text-[#657166]">properties</span></div>
                            <span class="text-xs text-emerald-700 font-medium">Waiting lists active</span>
                        </div>
                        <div class="text-xs font-bold text-[#1f422c] flex items-center gap-1">
                            View shortlisted homes &rarr;
                        </div>
                    </div>
                </div>

                <!-- Section: Homes for you -->
                <div class="space-y-4">
                    <div class="flex items-center justify-between">
                        <div>
                            <h2 class="text-xl font-bold text-[#112519]">Durham Homes for You</h2>
                            <p class="text-xs text-[#657166]">Based on your Durham department and lifestyle preferences</p>
                        </div>
                        <button onclick="switchTab('discover')" class="text-xs font-bold text-[#1f422c] hover:underline">
                            View all &rarr;
                        </button>
                    </div>

                    <div id="homes-grid" class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
                        <!-- Populated dynamically -->
                    </div>
                </div>

                <!-- Section: Your potential housemates -->
                <div class="space-y-4 pt-4">
                    <div class="flex items-center justify-between">
                        <div>
                            <h2 class="text-xl font-bold text-[#112519]">Your potential Durham housemates</h2>
                            <p class="text-xs text-[#657166]">Students viewing the same Durham properties with compatible MBTI vibes</p>
                        </div>
                        <button onclick="switchTab('profile')" class="text-xs font-bold text-[#1f422c] hover:underline">
                            See everyone &rarr;
                        </button>
                    </div>

                    <div id="potential-roommates-home-grid" class="grid grid-cols-1 md:grid-cols-3 gap-5">
                        <!-- Populated dynamically -->
                    </div>
                </div>

            </section>

            <!-- TAB 2: SHORTLISTED HOMES -->
            <section id="tab-shortlist" class="p-6 md:p-8 space-y-6 hidden animate-fade-in">
                <div>
                    <h1 class="text-2xl md:text-3xl font-bold text-[#112519]">My Shortlist & Saved Homes</h1>
                    <p class="text-xs text-[#657166] mt-1">Durham properties you've bookmarked and waiting lists you have joined.</p>
                </div>
                
                <div id="shortlist-grid" class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
                    <!-- Populated via JS -->
                </div>
            </section>

            <!-- TAB 3: SECURE MESSAGES & COMMUNITY CHAT -->
            <section id="tab-messages" class="p-6 md:p-8 space-y-6 hidden animate-fade-in">
                <div class="bg-white rounded-3xl border border-[#e3f1e5] shadow-xs overflow-hidden grid grid-cols-1 md:grid-cols-3 h-[calc(100vh-160px)]">
                    <div class="border-r border-[#e3f1e5] flex flex-col bg-[#f9f8f4]">
                        <div class="p-4 border-b border-[#e3f1e5] bg-white">
                            <h3 class="font-bold text-[#112519] text-sm flex items-center justify-between">
                                <span>Messages & Connections</span>
                                <span class="bg-[#e3f1e5] text-[#112519] text-[10px] px-2 py-0.5 rounded-full font-bold">3 Active</span>
                            </h3>
                            <p class="text-[11px] text-[#657166] mt-0.5">Secure LinkedIn-style student chat</p>
                        </div>
                        <div id="chat-contacts-list" class="overflow-y-auto custom-scrollbar flex-grow divide-y divide-[#e3f1e5]/50">
                            <!-- Populated via JS -->
                        </div>
                    </div>

                    <div class="md:col-span-2 flex flex-col bg-white">
                        <div id="active-chat-header" class="p-4 border-b border-[#e3f1e5] flex items-center justify-between bg-white">
                            <!-- Populated via JS -->
                        </div>
                        <div id="active-chat-messages" class="flex-grow overflow-y-auto custom-scrollbar p-5 space-y-4 bg-[#f9f8f4]">
                            <!-- Populated via JS -->
                        </div>
                        <div id="active-chat-input-area" class="p-4 border-t border-[#e3f1e5] bg-white">
                            <form onsubmit="sendChatMessage(event)" class="flex gap-2">
                                <input type="text" id="chat-input-field" placeholder="Type a secure message..." class="flex-grow px-4 py-2.5 bg-[#f9f8f4] border border-slate-200 rounded-2xl text-xs focus:outline-none focus:border-[#112519]">
                                <button type="submit" class="px-5 py-2.5 bg-[#112519] hover:bg-[#1f422c] text-[#e3f1e5] font-bold rounded-2xl text-xs transition">
                                    Send
                                </button>
                            </form>
                        </div>
                    </div>
                </div>
            </section>

            <!-- TAB 4: MY PROFILE & VIBE CHECK (Combined Setup Form) -->
            <section id="tab-profile" class="p-6 md:p-8 space-y-6 hidden animate-fade-in max-w-4xl mx-auto w-full">
                <div class="bg-white rounded-3xl p-6 md:p-8 border border-[#e3f1e5] shadow-xs space-y-8">
                    
                    <!-- Header prompt -->
                    <div class="bg-[#e3f1e5]/40 border border-[#e3f1e5] p-4 rounded-2xl flex items-center gap-3">
                        <i class="fa-solid fa-circle-info text-[#1f422c] text-lg"></i>
                        <p class="text-xs text-[#112519] font-medium">
                            This is what other Durham students see when deciding whether to share a place with you.
                        </p>
                    </div>

