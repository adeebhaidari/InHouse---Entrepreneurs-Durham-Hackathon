        // --- SECURE CHAT LOGIC ---
        function requestConnection(userId, userName) {
            const existing = chatsData.find(c => c.withUserId === userId);
            if (!existing) {
                chatsData.push({
                    id: 'chat-' + userId,
                    withUserId: userId,
                    status: 'connected',
                    messages: [
                        { sender: userId, text: `Connection accepted! Let's chat about Durham private housing.`, time: 'Just now' }
                    ]
                });
            }
            showToast(`Secure connection established with ${userName}!`);
            switchTab('messages');
            renderChatContacts();
            renderActiveChat();
        }

        function renderChatContacts() {
            const list = document.getElementById('chat-contacts-list');
            if (!list) return;

            list.innerHTML = chatsData.map(chat => {
                const rm = dummyRoommates.find(r => r.id === chat.withUserId);
                if (!rm) return '';
                const lastMsg = chat.messages[chat.messages.length - 1] || {};
                const isActive = chat.id === activeChatId;

                return `
                    <div onclick="selectChat('${chat.id}')" class="p-3.5 cursor-pointer transition hover:bg-[#e3f1e5]/40 flex items-center gap-3 ${isActive ? 'bg-[#e3f1e5]/60 border-l-4 border-[#112519]' : ''}">
                        <img src="${rm.avatar}" class="w-10 h-10 rounded-full object-cover">
                        <div class="flex-grow min-w-0">
                            <div class="flex items-center justify-between">
                                <h4 class="font-bold text-xs text-[#112519] truncate">${rm.name}</h4>
                                <span class="text-[9px] text-[#657166]">${lastMsg.time || ''}</span>
                            </div>
                            <p class="text-[11px] text-[#657166] truncate mt-0.5">${lastMsg.text || ''}</p>
                        </div>
                    </div>
                `;
            }).join('');
        }

        function selectChat(chatId) {
            activeChatId = chatId;
            renderChatContacts();
            renderActiveChat();
        }

        function renderActiveChat() {
            const chat = chatsData.find(c => c.id === activeChatId);
            const header = document.getElementById('active-chat-header');
            const messagesEl = document.getElementById('active-chat-messages');
            if (!chat || !header || !messagesEl) return;

            const rm = dummyRoommates.find(r => r.id === chat.withUserId);

            header.innerHTML = `
                <div class="flex items-center gap-3">
                    <img src="${rm.avatar}" class="w-9 h-9 rounded-full object-cover">
                    <div>
                        <h4 class="font-bold text-xs text-[#112519]">${rm.name}</h4>
                        <span class="text-[10px] text-[#1f422c] font-bold">Secure Student Chat &bull; MBTI ${rm.mbti}</span>
                    </div>
                </div>
            `;

            messagesEl.innerHTML = chat.messages.map(m => {
                const isMe = m.sender === currentUser.id;
                return `
                    <div class="flex flex-col ${isMe ? 'items-end' : 'items-start'}">
                        <div class="max-w-[75%] rounded-2xl px-4 py-2.5 text-xs shadow-xs ${isMe ? 'bg-[#112519] text-[#e3f1e5] rounded-br-none' : 'bg-white border border-[#e3f1e5] text-[#112519] rounded-bl-none'}">
                            ${m.text}
                        </div>
                        <span class="text-[9px] text-[#657166] mt-1 px-1">${m.time}</span>
                    </div>
                `;
            }).join('');

            messagesEl.scrollTop = messagesEl.scrollHeight;
        }

        function sendChatMessage(e) {
            e.preventDefault();
            const input = document.getElementById('chat-input-field');
            const text = input.value.trim();
            if (!text) return;

            const chat = chatsData.find(c => c.id === activeChatId);
            if (chat) {
                chat.messages.push({ sender: currentUser.id, text: text, time: 'Just now' });
                input.value = '';
                renderActiveChat();
                renderChatContacts();
            }
        }

