        // --- Chat System ---
        function startChat(userId) {
            if(!chats.find(c => c.uid === userId)) chats.push({ uid: userId, msgs: [] });
            activeChat = userId;
            switchTab('messages');
            renderChats();
        }

        function renderChats() {
            const list = document.getElementById('chat-contacts-list');
            if(chats.length === 0) {
                list.innerHTML = `<div class="p-6 text-center text-xs text-inhouse-muted">No messages yet.</div>`;
                return;
            }
            
            list.innerHTML = chats.map(c => {
                const h = housemates.find(x => x.id === c.uid);
                const last = c.msgs[c.msgs.length - 1]?.text || 'Say hi!';
                const isActive = c.uid === activeChat;
                return `
                    <div class="p-4 cursor-pointer flex items-center gap-3 transition ${isActive ? 'bg-inhouse-sage/50 border-l-4 border-inhouse-dark' : 'hover:bg-white'}" onclick="activeChat='${c.uid}'; renderChats();">
                        ${h.avatar ? `<img src="${h.avatar}" class="w-10 h-10 rounded-full object-cover">` : `<div class="w-10 h-10 rounded-full ${h.color} flex items-center justify-center font-bold text-xs">${h.init}</div>`}
