                            </div>
                        </div>
                    `;
                }).join('');
            }
            msgsArea.scrollTop = msgsArea.scrollHeight;
        }

        function sendMessage(e) {
            e.preventDefault();
            const input = document.getElementById('chat-input-field');
            const text = input.value.trim();
            if(!text || !activeChat) return;

            const c = chats.find(x => x.uid === activeChat);
            c.msgs.push({ sender: 'jamie', text });
            input.value = '';
            renderChats();

            // Exact requested auto-reply
            setTimeout(() => {
                c.msgs.push({ sender: activeChat, text: "Hi, yeah thats the plan :)" });
                renderChats();
            }, 1000);
        }

        // --- Modals & Tabs Utilities ---
        function switchTab(id) {
            ['discover', 'shortlist', 'messages', 'profile'].forEach(t => {
