<!DOCTYPE html>
<html lang="en" class="h-full">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>InHouse - Find your next home</title>
    <!-- Tailwind CSS CDN -->
    <script src="https://cdn.tailwindcss.com"></script>
    <!-- FontAwesome -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <!-- Google Fonts -->
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
    <script>
        tailwind.config = {
            theme: {
                extend: {
                    fontFamily: { sans: ['Inter', 'sans-serif'] },
                    colors: {
                        inhouse: {
                            bg: '#FDFCF8',
                            sidebar: '#F9F8F4',
                            dark: '#17362D',
                            sage: '#E8F3E1',
                            sageHover: '#d1e6c3',
                            peach: '#F9EBE0',
                            peachHover: '#F4DFCD',
                            muted: '#6B7A75',
                            border: '#EAE6DB'
                        }
                    }
                }
            }
        }
    </script>
    <style>
        body { font-family: 'Inter', sans-serif; background-color: #FDFCF8; color: #17362D; }
        .custom-scrollbar::-webkit-scrollbar { width: 6px; height: 6px; }
        .custom-scrollbar::-webkit-scrollbar-track { background: transparent; }
        .custom-scrollbar::-webkit-scrollbar-thumb { background: #D1D5DB; border-radius: 10px; }
        .slide-fade { transition: opacity 0.8s ease-in-out; }
        @keyframes fadeIn {
            from { opacity: 0; transform: translateY(10px); }
            to { opacity: 1; transform: translateY(0); }
        }
        .animate-fade-in { animation: fadeIn 0.3s ease-out forwards; }
    </style>
</head>
<body class="h-full flex overflow-hidden selection:bg-inhouse-dark selection:text-inhouse-sage">

    <!-- Toast Notifications -->
    <div id="toast-container" class="fixed top-5 right-5 z-[100] flex flex-col gap-3 pointer-events-none"></div>

    <!-- Layout Container -->
    <div class="flex w-full h-full">
        
        <!-- Left Sidebar -->
        <aside class="w-64 bg-inhouse-sidebar border-r border-inhouse-border flex flex-col justify-between p-6 shrink-0 z-40 hidden md:flex">
            <div class="space-y-8">
                <!-- Logo -->
                <div class="flex items-center gap-2">
                    <img src="image_30d142.png" alt="InHouse" class="h-8 object-contain">
                </div>

                <!-- Navigation -->
                <div>
                    <span class="block text-[10px] font-bold tracking-widest text-inhouse-muted uppercase mb-4">Workspace</span>
                    <nav class="space-y-1.5">
                        <button onclick="switchTab('discover')" id="nav-discover" class="w-full flex items-center gap-3 px-4 py-2.5 rounded-2xl text-sm font-semibold transition bg-inhouse-sage text-inhouse-dark">
                            <i class="fa-regular fa-compass w-5 text-center text-lg"></i> Discover
                        </button>
                        <button onclick="switchTab('shortlist')" id="nav-shortlist" class="w-full flex items-center gap-3 px-4 py-2.5 rounded-2xl text-sm font-semibold transition text-inhouse-muted hover:bg-inhouse-border/50 hover:text-inhouse-dark">
                            <i class="fa-regular fa-bookmark w-5 text-center text-lg"></i> My shortlist
                        </button>
                        <button onclick="switchTab('messages')" id="nav-messages" class="w-full flex items-center justify-between px-4 py-2.5 rounded-2xl text-sm font-semibold transition text-inhouse-muted hover:bg-inhouse-border/50 hover:text-inhouse-dark">
                            <div class="flex items-center gap-3">
                                <i class="fa-regular fa-comment w-5 text-center text-lg"></i> Messages
                            </div>
                            <span id="sidebar-msg-badge" class="bg-inhouse-sage text-inhouse-dark text-[10px] font-bold px-2 py-0.5 rounded-full hidden">0</span>
                        </button>
                        <button onclick="switchTab('profile')" id="nav-profile" class="w-full flex items-center gap-3 px-4 py-2.5 rounded-2xl text-sm font-semibold transition text-inhouse-muted hover:bg-inhouse-border/50 hover:text-inhouse-dark">
                            <i class="fa-regular fa-user w-5 text-center text-lg"></i> My profile
                        </button>
                    </nav>
                </div>
            </div>

            <!-- Bottom Sidebar Area -->
            <div class="space-y-5">
                <!-- Promo Box -->
                <div class="bg-inhouse-dark text-inhouse-sage p-5 rounded-3xl relative overflow-hidden">
                    <div class="absolute top-3 left-4 text-inhouse-sage">
                        <i class="fa-solid fa-sparkles text-sm"></i>
                    </div>
                    <h4 class="font-bold text-sm mt-4 mb-2">Make your profile shine</h4>
                    <p class="text-[11px] text-inhouse-sage/80 leading-relaxed mb-4">Complete your profile to get better housemate matches.</p>
                    <button onclick="switchTab('profile')" class="w-full py-2 bg-inhouse-sage hover:bg-white text-inhouse-dark font-bold text-xs rounded-xl transition">
                        Complete profile &rarr;
                    </button>
                </div>

                <!-- User Profile Snippet -->
                <div class="pt-4 border-t border-inhouse-border flex items-center gap-3 cursor-pointer group" onclick="switchTab('profile')">
                    <div class="w-9 h-9 rounded-full bg-yellow-200 text-yellow-800 font-bold flex items-center justify-center text-sm shrink-0 border border-yellow-300" id="sidebar-avatar-initials">JS</div>
                    <div class="min-w-0">
                        <span id="sidebar-user-name" class="block text-xs font-bold text-inhouse-dark truncate group-hover:text-black">Jamie Smith</span>
                        <span id="sidebar-user-uni" class="block text-[10px] text-inhouse-muted truncate">Durham University • Student</span>
                    </div>
                    <i class="fa-solid fa-chevron-right text-[10px] text-inhouse-muted ml-auto opacity-0 group-hover:opacity-100 transition"></i>
                </div>
            </div>
        </aside>

        <!-- Main View Area -->
        <main class="flex-grow flex flex-col min-w-0 bg-inhouse-bg overflow-y-auto custom-scrollbar relative">
            
            <!-- Top Header (No Search Bar) -->
            <header class="p-6 md:px-10 md:pt-10 md:pb-6 flex items-center justify-between sticky top-0 z-30 bg-inhouse-bg/90 backdrop-blur-sm">
                <div>
                    <!-- Mobile Logo (hidden on desktop) -->
                    <img src="image_30d142.png" alt="InHouse" class="h-6 object-contain md:hidden mb-2">
                </div>
                <div class="flex items-center gap-4 ml-auto">
                    <button class="text-inhouse-muted hover:text-inhouse-dark transition" onclick="showToast('No new notifications')">
                        <i class="fa-regular fa-bell text-lg"></i>
                    </button>
                    <div class="w-8 h-8 rounded-full bg-yellow-200 text-yellow-800 font-bold flex items-center justify-center text-xs border border-yellow-300 cursor-pointer" onclick="switchTab('profile')" id="header-avatar-initials">JS</div>
                </div>
            </header>

            <!-- TAB 1: DISCOVER -->
            <section id="tab-discover" class="px-6 md:px-10 pb-12 space-y-8 animate-fade-in max-w-7xl mx-auto w-full">
                
                <!-- Main Title -->
                <div>
                    <p class="text-[10px] font-bold tracking-widest text-inhouse-muted uppercase mb-2" id="current-date">TUESDAY, 17 JUNE 2025</p>
                    <h1 class="text-4xl md:text-5xl font-extrabold tracking-tight text-inhouse-dark mb-2">Find your next <span class="text-emerald-700 italic font-serif">home.</span></h1>
                    <p class="text-sm text-inhouse-muted">Places to live, people you'll love living with.</p>
                </div>

                <!-- Hero Sliding Banner -->
                <div class="relative rounded-3xl overflow-hidden h-48 md:h-64 shadow-sm w-full group">
                    <div id="hero-slider" class="absolute inset-0 w-full h-full bg-slate-900">
                        <!-- Populated by JS -->
                    </div>
                    <!-- Overlay Text -->
                    <div class="absolute inset-0 bg-gradient-to-r from-black/70 to-transparent flex flex-col justify-center p-8 z-10 pointer-events-none">
                        <h2 id="hero-title" class="text-2xl md:text-3xl font-extrabold text-white mb-2 drop-shadow-md">A fresh start. A familiar feeling.</h2>
                        <p id="hero-desc" class="text-sm text-slate-200 drop-shadow max-w-md">New to university? Find people you can feel at home with.</p>
                    </div>
                    <!-- Controls -->
                    <div class="absolute bottom-4 right-4 z-20 flex gap-2" id="hero-dots">
                        <!-- Populated by JS -->
                    </div>
                </div>

                <!-- Filters Bar -->
                <div class="flex flex-col md:flex-row gap-3">
                    <div class="flex-grow flex items-center bg-white border border-inhouse-border rounded-full px-5 py-3 hover:border-inhouse-muted transition shadow-sm">
                        <i class="fa-solid fa-location-dot text-inhouse-muted mr-3"></i>
                        <div class="flex flex-col flex-grow">
                            <span class="text-[9px] font-bold uppercase text-inhouse-muted tracking-wider">Looking Near</span>
                            <select id="location-select" onchange="handleLocationChange(event)" class="text-sm font-semibold text-inhouse-dark bg-transparent border-none outline-none cursor-pointer w-full appearance-none">
                                <option value="Durham University">Durham University</option>
                                <option value="University of Manchester">University of Manchester</option>
                                <option value="University of Leeds">University of Leeds</option>
                                <option value="UCL">UCL</option>
                            </select>
                        </div>
                        <i class="fa-solid fa-chevron-down text-[10px] text-inhouse-muted ml-2"></i>
                    </div>

                    <div class="flex-grow md:max-w-xs flex items-center bg-white border border-inhouse-border rounded-full px-5 py-3 hover:border-inhouse-muted transition shadow-sm">
                        <i class="fa-regular fa-calendar text-inhouse-muted mr-3"></i>
                        <div class="flex flex-col flex-grow">
                            <span class="text-[9px] font-bold uppercase text-inhouse-muted tracking-wider">Move In</span>
                            <input type="month" id="move-in-date" value="2025-09" class="text-sm font-semibold text-inhouse-dark bg-transparent border-none outline-none cursor-pointer appearance-none">
                        </div>
                        <i class="fa-solid fa-chevron-down text-[10px] text-inhouse-muted ml-2"></i>
                    </div>

                    <button class="bg-inhouse-sage hover:bg-inhouse-sageHover text-inhouse-dark font-semibold text-sm px-6 py-3 rounded-full flex items-center justify-center gap-2 transition border border-inhouse-border shadow-sm">
                        <i class="fa-solid fa-sliders"></i> Filters
                    </button>
                </div>

                <!-- Dashboard Stat Cards -->
                <div class="grid grid-cols-1 md:grid-cols-3 gap-5">
                    <!-- Card 1 -->
                    <div class="bg-inhouse-sage border border-inhouse-border p-6 rounded-3xl cursor-pointer hover:shadow-md transition" onclick="switchTab('profile')">
                        <div class="flex justify-between items-start mb-4">
                            <span class="text-[10px] font-bold text-emerald-800 tracking-wider uppercase">Your Match Profile</span>
                            <i class="fa-solid fa-sparkles text-emerald-700"></i>
                        </div>
                        <div class="text-4xl font-extrabold text-inhouse-dark mb-1">87%</div>
                        <p class="text-xs text-inhouse-dark/70 mb-4">profile completeness</p>
                        <div class="w-full bg-emerald-700/20 h-1.5 rounded-full overflow-hidden">
                            <div class="bg-emerald-700 h-full rounded-full" style="width: 87%"></div>
                        </div>
                    </div>

                    <!-- Card 2 -->
                    <div class="bg-white border border-inhouse-border p-6 rounded-3xl cursor-pointer hover:shadow-md transition">
                        <div class="flex justify-between items-start mb-4">
                            <span class="text-[10px] font-bold text-inhouse-muted tracking-wider uppercase">People Like You</span>
                            <i class="fa-solid fa-user-group text-inhouse-muted"></i>
                        </div>
                        <div class="text-4xl font-extrabold text-inhouse-dark mb-1">12 <span class="text-sm font-normal text-inhouse-muted">nearby</span></div>
                        <p class="text-xs text-inhouse-dark/70">looking for a similar home</p>
                    </div>

                    <!-- Card 3 -->
                    <div class="bg-inhouse-peach border border-inhouse-peachHover p-6 rounded-3xl cursor-pointer hover:shadow-md transition" onclick="switchTab('shortlist')">
                        <div class="flex justify-between items-start mb-4">
                            <span class="text-[10px] font-bold text-orange-800 tracking-wider uppercase">Saved Homes</span>
                            <i class="fa-regular fa-heart text-orange-800"></i>
                        </div>
                        <div class="text-4xl font-extrabold text-inhouse-dark mb-1" id="dash-saved-count">0 <span class="text-sm font-normal text-inhouse-muted">properties</span></div>
                        <p class="text-xs text-inhouse-dark/70" id="dash-saved-sub">0 have new activity</p>
                    </div>
                </div>

                <!-- Homes For You -->
                <div class="space-y-4 pt-4">
                    <div class="flex justify-between items-end">
                        <div>
                            <h2 class="text-xl font-bold text-inhouse-dark">Homes for you</h2>
                            <p class="text-xs text-inhouse-muted">Based on your preferences and profile</p>
                        </div>
                        <a href="#" class="text-xs font-semibold text-inhouse-dark hover:underline">View all &rarr;</a>
                    </div>
                    <div id="homes-grid" class="grid grid-cols-1 md:grid-cols-3 gap-6">
                        <!-- Populated by JS -->
                    </div>
                </div>

                <!-- Potential Housemates (Restored layout) -->
                <div class="space-y-4 pt-8">
                    <div class="flex justify-between items-end">
                        <div>
                            <h2 class="text-xl font-bold text-inhouse-dark">Your potential housemates</h2>
                            <p class="text-xs text-inhouse-muted">People viewing the same homes as you</p>
                        </div>
                        <a href="#" class="text-xs font-semibold text-inhouse-dark hover:underline">See everyone &rarr;</a>
                    </div>
                    <div id="housemates-grid" class="grid grid-cols-1 md:grid-cols-3 gap-4">
                        <!-- Populated by JS -->
                    </div>
                </div>

            </section>

            <!-- TAB 2: SHORTLIST -->
            <section id="tab-shortlist" class="px-6 md:px-10 pb-12 space-y-6 hidden animate-fade-in max-w-7xl mx-auto w-full">
                <h1 class="text-3xl font-extrabold text-inhouse-dark">My Shortlist</h1>
                <div id="shortlist-grid" class="grid grid-cols-1 md:grid-cols-3 gap-6"></div>
            </section>

            <!-- TAB 3: MESSAGES -->
            <section id="tab-messages" class="px-6 md:px-10 pb-12 hidden animate-fade-in max-w-6xl mx-auto w-full h-[calc(100vh-100px)]">
                <div class="bg-white rounded-3xl border border-inhouse-border shadow-sm flex flex-col md:flex-row h-full overflow-hidden">
                    <!-- Contacts -->
                    <div class="w-full md:w-1/3 border-r border-inhouse-border flex flex-col bg-inhouse-sidebar">
                        <div class="p-4 border-b border-inhouse-border bg-white">
                            <h3 class="font-bold text-inhouse-dark text-sm">Messages</h3>
                        </div>
                        <div id="chat-contacts-list" class="flex-grow overflow-y-auto custom-scrollbar divide-y divide-inhouse-border/50">
                            <!-- Populated -->
                        </div>
                    </div>
                    <!-- Active Chat -->
                    <div class="w-full md:w-2/3 flex flex-col bg-white">
                        <div id="active-chat-header" class="p-4 border-b border-inhouse-border flex items-center justify-between hidden"></div>
                        <div id="active-chat-messages" class="flex-grow overflow-y-auto p-6 space-y-4 bg-inhouse-bg flex flex-col">
                            <div class="m-auto text-center text-xs text-inhouse-muted">Select a chat to begin messaging.</div>
                        </div>
                        <div id="active-chat-input" class="p-4 border-t border-inhouse-border bg-white hidden">
                            <form onsubmit="sendMessage(event)" class="flex gap-2">
                                <input type="text" id="chat-input-field" placeholder="Type a message..." class="flex-grow bg-inhouse-sidebar border border-inhouse-border rounded-full px-5 py-2.5 text-sm focus:outline-none focus:border-inhouse-muted">
                                <button type="submit" class="bg-inhouse-dark text-inhouse-sage px-5 py-2.5 rounded-full font-bold text-sm hover:bg-black transition">Send</button>
                            </form>
                        </div>
                    </div>
                </div>
            </section>

            <!-- TAB 4: PROFILE -->
            <section id="tab-profile" class="px-6 md:px-10 pb-20 hidden animate-fade-in max-w-3xl mx-auto w-full">
                <h1 class="text-3xl font-extrabold text-inhouse-dark mb-6">Set up your profile</h1>
                
                <div class="bg-white rounded-3xl p-8 border border-inhouse-border shadow-sm space-y-8">
                    <p class="text-xs font-semibold text-inhouse-muted">This is what other students see when deciding whether to share a place with you.</p>
                    
                    <form onsubmit="saveProfile(event)" class="space-y-8">
                        <!-- Basics -->
                        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                            <div>
                                <label class="block text-xs font-bold text-inhouse-dark mb-2">Full name</label>
                                <input type="text" id="prof-name" class="w-full bg-inhouse-sidebar border border-inhouse-border rounded-xl px-4 py-2.5 text-sm focus:outline-none focus:border-inhouse-muted" required>
                            </div>
                            <div>
                                <label class="block text-xs font-bold text-inhouse-dark mb-2">University</label>
                                <select id="prof-uni" class="w-full bg-inhouse-sidebar border border-inhouse-border rounded-xl px-4 py-2.5 text-sm focus:outline-none focus:border-inhouse-muted">
                                    <option value="Durham University">Durham University</option>
                                    <option value="University of Manchester">University of Manchester</option>
                                    <option value="University of Leeds">University of Leeds</option>
                                </select>
                            </div>
                        </div>

                        <!-- MBTI -->
                        <div class="pt-6 border-t border-inhouse-border">
                            <h3 class="font-bold text-sm text-inhouse-dark mb-1">MBTI vibe check</h3>
                            <p class="text-xs text-inhouse-muted mb-4">Pick your type — we use it to score compatibility with other students.</p>
                            <div class="grid grid-cols-2 md:grid-cols-4 gap-3" id="mbti-grid">
                                <!-- Populated dynamically -->
                            </div>
                        </div>

                        <div class="flex justify-end pt-4">
                            <button type="submit" class="bg-inhouse-sage hover:bg-inhouse-sageHover text-inhouse-dark font-bold px-8 py-3 rounded-full transition shadow-sm text-sm">Save Profile</button>
                        </div>
                    </form>
                </div>
            </section>

        </main>
    </div>

    <!-- MODALS -->

    <!-- Property Modal (z-50) -->
    <div id="property-modal" class="fixed inset-0 bg-inhouse-dark/80 backdrop-blur-sm z-[50] flex items-center justify-center p-4 hidden">
        <div class="bg-white rounded-3xl shadow-2xl max-w-4xl w-full max-h-[90vh] overflow-y-auto custom-scrollbar relative animate-fade-in border border-inhouse-border">
            <button onclick="closeModal('property-modal')" class="absolute top-4 right-4 z-20 w-10 h-10 bg-white/90 hover:bg-white text-inhouse-dark rounded-full flex items-center justify-center shadow transition font-bold text-lg">
                <i class="fa-solid fa-xmark"></i>
            </button>
            <div id="property-modal-content"></div>
        </div>
    </div>

    <!-- Student Profile Modal (z-60) -->
    <div id="student-modal" class="fixed inset-0 bg-inhouse-dark/80 backdrop-blur-sm z-[60] flex items-center justify-center p-4 hidden">
        <div class="bg-white rounded-3xl shadow-xl max-w-sm w-full p-6 relative animate-fade-in border border-inhouse-border">
            <button onclick="closeModal('student-modal')" class="absolute top-4 right-4 text-inhouse-muted hover:text-inhouse-dark transition">
                <i class="fa-solid fa-xmark text-xl"></i>
            </button>
            <div id="student-modal-content" class="text-center pt-4"></div>
        </div>
    </div>

    <!-- Payment Modal (z-70) -->
    <div id="payment-modal" class="fixed inset-0 bg-inhouse-dark/80 backdrop-blur-sm z-[70] flex items-center justify-center p-4 hidden">
        <div class="bg-white rounded-3xl shadow-xl max-w-sm w-full p-6 relative animate-fade-in border border-inhouse-border">
            <button onclick="closeModal('payment-modal')" class="absolute top-4 right-4 text-inhouse-muted hover:text-inhouse-dark transition">
                <i class="fa-solid fa-xmark text-xl"></i>
            </button>
            <h3 class="font-bold text-lg text-inhouse-dark mb-2">Secure Reservation</h3>
            <p class="text-xs text-inhouse-muted mb-6">Process a holding deposit to reserve this property.</p>
            <div class="space-y-3">
                <button onclick="processPayment('Google Pay')" class="w-full flex justify-between items-center p-4 bg-inhouse-sidebar border border-inhouse-border rounded-2xl hover:border-black transition">
                    <span class="font-bold text-sm text-inhouse-dark">Google Pay</span>
                    <i class="fa-brands fa-google-pay text-3xl text-slate-700"></i>
                </button>
                <button onclick="processPayment('Visa')" class="w-full flex justify-between items-center p-4 bg-inhouse-sidebar border border-inhouse-border rounded-2xl hover:border-blue-600 transition">
                    <span class="font-bold text-sm text-inhouse-dark">Visa</span>
                    <i class="fa-brands fa-cc-visa text-2xl text-blue-700"></i>
                </button>
                <button onclick="processPayment('Mastercard')" class="w-full flex justify-between items-center p-4 bg-inhouse-sidebar border border-inhouse-border rounded-2xl hover:border-red-500 transition">
                    <span class="font-bold text-sm text-inhouse-dark">Mastercard</span>
                    <i class="fa-brands fa-cc-mastercard text-2xl text-red-500"></i>
                </button>
            </div>
        </div>
    </div>

    <!-- Scripts -->
    <script>
        // Data Models
        const mbtiList = [
            { code: 'INTJ', desc: 'Strategic, independent' }, { code: 'INTP', desc: 'Curious, analytical' },
            { code: 'ENTJ', desc: 'Decisive, leader' }, { code: 'ENTP', desc: 'Inventive, debater' },
            { code: 'INFJ', desc: 'Insightful, idealistic' }, { code: 'INFP', desc: 'Authentic, empathetic' },
            { code: 'ENFJ', desc: 'Warm, organised' }, { code: 'ENFP', desc: 'Enthusiastic, free-spirited' },
            { code: 'ISTJ', desc: 'Reliable, structured' }, { code: 'ISFJ', desc: 'Caring, conscientious' },
            { code: 'ESTJ', desc: 'Practical, direct' }, { code: 'ESFJ', desc: 'Friendly, supportive' },
            { code: 'ISTP', desc: 'Handy, adaptable' }, { code: 'ISFP', desc: 'Gentle, artistic' },
            { code: 'ESTP', desc: 'Bold, energetic' }, { code: 'ESFP', desc: 'Playful, sociable' }
        ];

        let currentUser = { id: 'jamie', name: 'Jamie Smith', uni: 'Durham University', mbti: 'INTJ' };
        
        // Exact slider images & text specified by user
        const sliderData = [
            { img: 'image_266784.png', title: 'A fresh start. A familiar feeling.', desc: 'New to university? Find people you can feel at home with.' },
            { img: 'image_2667c3.jpg', title: 'Match your mates', desc: 'Find compatible roommates. Quick and personalised.' },
            { img: 'image_266859.jpg', title: 'Less searching. More settling in.', desc: 'Bring your housemate and housing search together with InHouse.' }
        ];

        let properties = [
            {
                id: 'p1', title: 'The Foundry', loc: 'Earlham Street, Durham', price: 895, type: 'Studio',
                beds: 1, baths: 1, match: '94%', interested: 3,
                images: ['https://images.unsplash.com/photo-1522708323590-d24dbb6b0267?w=800&q=80', 'https://images.unsplash.com/photo-1502672260266-1c1ef2d93688?w=800&q=80'],
                desc: 'Modern student studio right in the city center. Fully furnished with high speed wifi and utility bills included.'
            },
            {
                id: 'p2', title: 'Parkside House', loc: 'Mill Road, Durham', price: 760, type: 'Shared',
                beds: 4, baths: 2, match: '91%', interested: 5,
                images: ['https://images.unsplash.com/photo-1502672260266-1c1ef2d93688?w=800&q=80', 'https://images.unsplash.com/photo-1555854877-bab0e564b8d5?w=800&q=80'],
                desc: 'Spacious 4-bedroom house with a large communal kitchen and living area. Perfect for a group of friends.'
