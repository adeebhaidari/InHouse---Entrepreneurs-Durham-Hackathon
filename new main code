            document.getElementById('modal-img').src = p.images[activeImgIdx];
            document.getElementById('modal-img-counter').textContent = `${activeImgIdx + 1} / ${p.images.length}`;
        }

        function switchPropTab(tab) {
            if(tab === 'overview') {
                document.getElementById('prop-sec-overview').classList.replace('hidden', 'block');
                document.getElementById('prop-sec-3d').classList.replace('block', 'hidden');
                document.getElementById('btn-prop-overview').className = "pb-2 text-sm font-bold text-inhouse-dark border-b-2 border-inhouse-dark";
